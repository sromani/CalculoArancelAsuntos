# Copiá a .env en el VPS: cp .env.example .env && nano .env

# Postgres (usá contraseña sin caracteres raros o codificá la URL)
POSTGRES_USER=escribanos
POSTGRES_PASSWORD=cambiar_password_seguro
POSTGRES_DB=sistema_escribanos_db

# Misma clave en API y front
JWT_SECRET=cambiar_jwt_minimo_32_caracteres_aleatorios
AUTH_SECRET=cambiar_auth_secret_minimo_32_caracteres

# Origen público (IP o dominio con https). Ej: http://203.0.113.10 o https://app.tudominio.com
FRONTEND_ORIGIN=http://TU_IP_O_DOMINIO

# Opcional: HTTPS automático con Caddy (dejá vacío para solo puerto 80 / HTTP)
# DOMAIN=app.tudominio.com
# ACME_EMAIL=admin@tudominio.com
