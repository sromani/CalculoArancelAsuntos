{
  "name": "escribanos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "prisma generate && next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:estudio:create": "docker exec sistema_escribanos_postgres psql -U admin_escribanos -d postgres -c \"CREATE DATABASE sistema_escribanos_estudio;\"",
    "db:estudio:push": "prisma db push",
    "db:estudio:setup": "node scripts/ensure-estudio-db.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pg": "^8.20.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
