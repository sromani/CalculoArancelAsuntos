{
  "name": "escribanos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "dotenv -e .env.local --override -- prisma generate --schema ./prisma/schema.prisma && next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "generate:arancel": "node scripts/generate-arancel-capitulo-i.mjs",
    "generate:arancel:cert": "node scripts/generate-arancel-certificaciones.mjs",
    "generate:arancel:actas": "node scripts/generate-arancel-actas-protocolizaciones.mjs",
    "generate:usufructo": "node scripts/generate-usufructo-coefs.mjs",
    "prisma:generate": "dotenv -e .env.local --override -- prisma generate --schema ./prisma/schema.prisma",
    "prisma:generate:win": "node scripts/prisma-generate-win.cjs",
    "postinstall": "dotenv -e .env.local --override -- prisma generate --schema ./prisma/schema.prisma",
    "db:estudio:create": "docker exec sistema_escribanos_postgres psql -U admin_escribanos -d postgres -c \"CREATE DATABASE sistema_escribanos_estudio;\"",
    "db:estudio:push": "dotenv -e .env.local --override -- prisma db push --schema ./prisma/schema.prisma",
    "db:estudio:migrate": "dotenv -e .env.local --override -- prisma migrate deploy --schema ./prisma/schema.prisma",
    "db:estudio:migrate:dev": "dotenv -e .env.local --override -- prisma migrate dev --schema ./prisma/schema.prisma",
    "db:estudio:setup": "node scripts/ensure-estudio-db.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "jose": "^5.9.6",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pg": "^8.20.0",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
